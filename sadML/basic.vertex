#version 330 core

layout(location = 0) in vec3 a_position;
layout(location = 1) in vec4 a_color;

out vec4 v_color;

uniform vec4 u_color1;
uniform vec4 u_color2;

void main()
{
	gl_Position = vec4(a_position, 1.0);
	if(a_position[0] == -0.5){
		v_color = u_color1;
	}else {
		v_color = u_color2;
	}
	
}